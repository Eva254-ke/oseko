<section class="trust-strip" aria-labelledby="trust-strip-title">
  <div class="container trust-strip__inner">
    <div class="trust-strip__summary">
      <p class="trust-strip__label" id="trust-strip-title">
        Customer feedback
      </p>

      <div class="trust-strip__rating">
        <div
          class="trust-strip__stars"
          aria-label="Placeholder five-star rating. Replace with live Trustpilot rating."
        >
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
        </div>

        <p>
          <strong>4.8 out of 5</strong>
          <span>from 126 reviews</span>
        </p>
      </div>

      <p class="trust-strip__source">
        <span class="trustpilot-mark" aria-hidden="true">★</span>
        Reviews on <strong>Trustpilot</strong>
      </p>
    </div>

    <div class="trust-strip__reviews" aria-label="Sample customer reviews">
      <article class="trust-review">
        <div class="trust-review__stars" aria-label="Five out of five stars">
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
        </div>

        <blockquote>
          “My sofa and carpet looked fresh again. The team arrived on time and
          worked carefully.”
        </blockquote>

        <p class="trust-review__author">
          <strong>Sarah M.</strong>
          <span>Verified customer — placeholder</span>
        </p>
      </article>

      <article class="trust-review">
        <div class="trust-review__stars" aria-label="Five out of five stars">
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
          <span aria-hidden="true">★</span>
        </div>

        <blockquote>
          “Booked an office deep clean and the result was excellent. Clear
          communication from start to finish.”
        </blockquote>

        <p class="trust-review__author">
          <strong>Daniel K.</strong>
          <span>Verified customer — placeholder</span>
        </p>
      </article>
    </div>

    <a
      class="trust-strip__link"
      href="https://www.trustpilot.com/"
      target="_blank"
      rel="noopener noreferrer"
    >
      Read reviews
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>