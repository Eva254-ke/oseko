---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "Services", href: "/services" },
  { label: "Prices", href: "/prices" },
  { label: "Service Areas", href: "/service-areas" },
  { label: "About Us", href: "/about" },
  { label: "Contact", href: "/contact" },
  { label: "Apply for a Job", href: "/apply-for-a-job" },
];

const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="site-header">
  <div class="header-topbar">
    <div class="container header-topbar__inner">
      <p>Professional cleaning for homes, offices, vehicles and properties.</p>

      <div class="header-topbar__contacts">
        <a href="tel:+254719184210">Call: 0719 184 210</a>

        <a
          href="https://wa.me/254793783514?text=Hello%20Oseko%20Solutions%2C%20I%20would%20like%20to%20book%20a%20cleaning%20service."
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp: 0793 783 514
        </a>
      </div>
    </div>
  </div>

  <div class="header-main">
    <div class="container header-main__inner">
      <a class="brand" href="/" aria-label="Oseko Solutions home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 52 52" fill="none">
            <circle cx="26" cy="26" r="24" fill="currentColor" />

            <path
              d="M12 25.5 26 14l14 11.5v13.2c0 1.27-1.03 2.3-2.3 2.3H14.3c-1.27 0-2.3-1.03-2.3-2.3V25.5Z"
              fill="#FFFFFF"
            />

            <path d="M22 41V31h8v10" fill="currentColor" />

            <path
              d="M11.5 43c7.4-3.1 12.9-9.4 15.5-17.5"
              stroke="#F28C00"
              stroke-linecap="round"
              stroke-width="4"
            />
          </svg>
        </span>

        <span class="brand-text">
          <strong>OSEKO</strong>
          <span>SOLUTIONS</span>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={{ active: isActive(link.href) }}
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-actions">
        <a class="book-service-button" href="/book-a-service">
          Book a Service
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="mobile-nav"
    aria-label="Mobile navigation"
    hidden
  >
    <div class="container">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={{ active: isActive(link.href) }}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mobile-nav__actions">
        <a class="book-service-button" href="/book-a-service">
          Book a Service
        </a>

        <a
          class="whatsapp-button"
          href="https://wa.me/254793783514?text=Hello%20Oseko%20Solutions%2C%20I%20would%20like%20to%20book%20a%20cleaning%20service."
          target="_blank"
          rel="noopener noreferrer"
        >
          Chat on WhatsApp
        </a>

        <a class="mobile-call-link" href="tel:+254719184210">
          Call 0719 184 210
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");

  if (toggle && mobileMenu) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";

      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute(
        "aria-label",
        isOpen ? "Open navigation menu" : "Close navigation menu",
      );

      mobileMenu.hidden = isOpen;
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open navigation menu");
      });
    });
  }
</script>