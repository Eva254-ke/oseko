---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Oseko Solutions | Professional Cleaning Services",
  description = "Professional cleaning for homes, offices, apartments, vehicles and properties.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>